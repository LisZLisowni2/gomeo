class Dog {
    public name: string;

    public def new(name: string) {
        this->name = name;
    }
}

fun printDog(dog: &Dog) -> void {
    println(dog->name);
}

fun takeDog(take dog: Dog) -> void {
    println(dog->name);
}

fun main() -> void {
    let dog: Dog = new Dog("Rex");
    
    printDog(dog);

    takeDog(dog);

    // dog is not already owner of object
}
