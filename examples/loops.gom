fun main() -> void {
    mut i_1: i32 = 0;

    while (i_1 < 10) {
        if (i_1 % 2 == 0) {
            println(i_1);
        } 
        i_1++;
    }

    mut i = 0;

    do {
        println(i_1);
        i += 1;
    } while (i_1 < 10);

    for (mut i_2: i32; i_2 < 10; i_2++) {
        println(i_2);
    }
}
