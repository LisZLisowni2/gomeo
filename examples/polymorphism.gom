class Animal {
    public virtual fun makeNoice(); 
}

class Dog <- Animal {
    public fun makeNoice() {
        println("Hau!");
    }
}

class Cat <- Animal {
    public fun makeNoice() {
        println("Meow!");
    }
}

fun animalMakeNoice(animal: virtual Animal) -> void {
    animal->makeNoice();
}

fun main() -> void {
    let dog: Dog;
    let cat: Cat;

    animalMakeNoice(dog);
    animalMakeNoice(cat);
}
